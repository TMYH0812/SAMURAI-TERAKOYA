      "source": [
        "class Human:\n",
        "    def __init__(self, name: str, age: int):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "\n",
        "    def printinfo(self):\n",
        "        print(\"名前：\", self.name)\n",
        "        print(\"年齢：\", self.age)\n",
        "\n",
        "\n",
        "# Humanクラスのインスタンスを作成\n",
        "human = Human(\"田中太郎\", 25)\n",
        "\n",
        "# printinfoメソッドを実行\n",
        "human.printinfo()"
      ]
    }
  ]
