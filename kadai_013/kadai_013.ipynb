      ],
      "source": [
        "def calculate_tax(price: int) -> int:\n",
        "    # 消費税を計算\n",
        "    tax = price * 10 // 100\n",
        "\n",
        "    # 戻り値\n",
        "    return tax\n",
        "\n",
        "\n",
        "# 商品価格\n",
        "price = 1000\n",
        "\n",
        "# 関数を呼び出す\n",
        "tax = calculate_tax(price)\n",
        "\n",
        "print(\"商品価格：\",f\"{price}円\")\n",
        "print(\"消費税：\", f\"{tax}円\")\n",
        "print(\"税込価格：\", price + tax,\"円\")"
      ]
    }
  ]
